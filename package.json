{
  "name": "bjnexus-hospitality",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "import:fursat": "tsx scripts/import-fursat.ts",
    "test": "vitest run",
